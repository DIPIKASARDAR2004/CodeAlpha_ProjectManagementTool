# TaskFlow Supabase Environment Configuration Template
# Copy this file to .env.local and replace with your actual project values:
# cp .env.example .env.local

# Found in Supabase Dashboard: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Project API Anon / Public Key (or Publishable Key in newer dashboards)
# Both variable names are supported by the TaskFlow Supabase client.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# NOTE: Never add the service_role key to frontend environment variables.

